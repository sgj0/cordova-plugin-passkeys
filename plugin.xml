<?xml version="1.0" encoding="UTF-8" ?>
<plugin
  id="cordova-plugin-android-passkeys"
  version="0.1.0"
  xmlns="http://apache.org/ns/cordova/plugins/1.0"
>
    <name>PasskeysPlugin</name>
	<description>Cordova Plugin for Android to use Passkeys</description>
	<license>MIT</license>
	<repo>https://github.com/sgj0/cordova-plugin-passkeys</repo>
	<issue>https://github.com/sgj0/cordova-plugin-passkeys/issues</issue>
	<keywords>cordova,passkeys,android</keywords>
	<engines>
		<engine name="cordova" version=">=3.0.0" />
	</engines>
    <js-module src="www/passkey.js" name="Passkey">
        <climb target="window.plugins.passkey" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="PasskeyPlugin">
                <param
					name="android-package"
					value="net.sgj0.cordova.plugin.PasskeyPlugin"
				/>
            </feature>
        </config-file>
        
        <source-file
			src="src/android/PasskeyPlugin.kt"
			target-dir="app/net/sgj0/cordova/plugin"
		/>
        
        <framework src="androidx.credentials:credentials:1.3.0" />
        <framework
			src="androidx.credentials:credentials-play-services-auth:1.3.0"
		/>
    </platform>
</plugin>
